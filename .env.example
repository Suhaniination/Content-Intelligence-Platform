# ─── AI Provider ──────────────────────────────────────────────────────────────
# Set to "groq" (default) or "openai"
AI_PROVIDER=groq

# Groq API key — get one free at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq model (fast, free-tier friendly)
GROQ_MODEL=llama-3.1-8b-instant

# OpenAI API key — only needed if AI_PROVIDER=openai
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite (default, no setup needed)
DATABASE_URL=sqlite:///./content_intel.db

# PostgreSQL (optional, for live deployment)
# DATABASE_URL=postgresql://user:password@localhost:5432/content_intel
